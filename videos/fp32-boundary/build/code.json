     "no": 148,
     "text": "    assign normal_val = ftz_out  ? {sign_r, 31'd0}"
    },
    {
     "no": 149,
     "text": "                      : overflow ? {sign_r, 8'hFF, 23'd0}"
    },
    {
     "no": 150,
     "text": "                      :            {sign_r, exp_final_s[7:0], frac_final};"
    }
   ]
  },
