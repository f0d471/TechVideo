   "lang": "Verilog",
   "lines": [
    {
     "no": 137,
     "text": "    wire [24:0] mant_rnd = {1'b0, prod_n[46:23]} + {24'd0, round_up}; // 舍入后尾数"
    },
    {
     "no": 138,
     "text": "    wire        mant_ovf = mant_rnd[24];                               // 尾数进位"
    },
    {
     "no": 139,
     "text": "    wire signed [9:0] exp_final_s = exp_n_s"
    },
    {
     "no": 140,
     "text": "                                      + (mant_ovf ? 10'sd1 : 10'sd0); // 最终阶码"
    },
    {
     "no": 141,
     "text": "    wire ftz_out  = (exp_final_s <= 10'sd0);                           // 下溢 FTZ"
    },
    {
     "no": 142,
     "text": "    wire overflow = (exp_final_s >= 10'sd255);                         // 上溢"
    },
    {
     "no": 143,
     "text": "    wire [22:0] frac_final = mant_ovf ? 23'd0 : mant_rnd[22:0];        // 最终小数位"
    }
   ]
  },
  "select": {
   "source": "anchorfp",
